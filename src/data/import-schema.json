{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifeBatt verified catalog import",
  "description": "Future import contract. Only verified supplier data; no demo products.",
  "type": "object",
  "required": ["checkedAt", "source", "products"],
  "properties": {
    "checkedAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categorySourceUid", "title", "verified"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "categorySourceUid": {"type": "string", "description": "UID from import-registry categories"},
          "title": {"type": "string", "minLength": 1},
          "verified": {"const": true},
          "sku": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "price": {"type": ["number", "null"], "minimum": 0},
          "currency": {"enum": ["RUB", null]},
          "availability": {"enum": ["in_stock", "on_request", "out_of_stock", null]},
          "images": {"type": "array", "items": {"type": "string"}},
          "specifications": {"type": "array", "items": {"type": "object", "required": ["name", "value", "source"], "properties": {"name": {"type": "string"}, "value": {"type": "string"}, "unit": {"type": ["string", "null"]}, "source": {"type": "string"}}}}
        }
      }
    }
  }
}
